<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kalkulator Aritmatika</title>
<style>
body { font-family: sans-serif; background: #f2f2f2; display: flex; justify-content: center; padding: 20px; }
.card { background: white; width: 100%; max-width: 400px; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
.header { background: #1676ff; color: white; text-align: center; padding: 20px; }
.header h2 { margin: 0; }
.header p { margin: 5px 0 0; font-size: 14px; }
.content { padding: 20px; }
label { display: block; margin: 15px 0 5px; }
input, select { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 16px; box-sizing: border-box; }
button { width: 100%; margin-top: 20px; background: #1676ff; color: white; border: none; padding: 14px; border-radius: 8px; font-size: 16px; cursor: pointer; }
.hasil { background: #22252f; color: white; text-align: center; padding: 20px; border-radius: 10px; margin-top: 20px; }
.hasil h1 { margin: 5px 0 0; font-size: 40px; }
</style>
</head>
<body>
<div class="card">
  <div class="header">
    <h2>Kalkulator Aritmatika</h2>
    <p>Siti Ayu Indah Sari - NIM. 262302015</p>
  </div>
  <div class="content">
    <label>Angka Pertama</label>
    <input type="number" id="angka1" placeholder="Masukkan angka">
    
    <label>Angka Kedua</label>
    <input type="number" id="angka2" placeholder="Masukkan angka">
    
    <label>Pilih Operator</label>
    <select id="operator">
      <option value="+">Penjumlahan (+)</option>
      <option value="-">Pengurangan (-)</option>
      <option value="*">Perkalian (x)</option>
      <option value="/">Pembagian (/)</option>
    </select>
    
    <button onclick="hitung()">Hitung</button>
    
    <div class="hasil">
      <div>HASIL PERHITUNGAN</div>
      <h1 id="hasil">0</h1>
    </div>
  </div>
</div>

<script>
function hitung() {
  let a = parseFloat(document.getElementById('angka1').value);
  let b = parseFloat(document.getElementById('angka2').value);
  let op = document.getElementById('operator').value;
  let hasil = 0;
  if (isNaN(a) || isNaN(b)) {
    document.getElementById('hasil').innerText = "Isi dulu angkanya";
    return;
  }
  if (op == '+') hasil = a + b;
  if (op == '-') hasil = a - b;
  if (op == '*') hasil = a * b;
  if (op == '/') hasil = b != 0 ? a / b : "Tidak bisa dibagi 0";
  document.getElementById('hasil').innerText = hasil;
}
</script>
</body>
</html>
